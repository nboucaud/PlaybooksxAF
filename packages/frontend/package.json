{
  "name": "frontend-monorepo",
  "private": true,
  "version": "1.0.0",
  "packageManager": "yarn@4.9.2",
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "admin",
    "component",
    "core",
    "common/env"
  ],
  "scripts": {
    "build:web": "yarn workspace web build",
    "build:admin": "yarn workspace admin build",
    "build:mobile": "yarn workspace mobile build",
    "build:all": "yarn build:web && yarn build:admin && yarn build:mobile"
  }
}

